{
  "name": "citynerve-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data": "node pipeline/run_all.mjs",
    "data:fog": "node pipeline/run_fog.mjs",
    "data:heat": "node pipeline/run_heat.mjs",
    "data:air": "node pipeline/run_air.mjs",
    "test": "node --test tests/*.test.js",
    "start": "node server/start.js",
    "package:netlify": "vite build && node scripts/package-netlify.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
